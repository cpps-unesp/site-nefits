---
import { Image, PortableText } from "emdash/ui";
import { buscarTexto } from "../lib/conteudo";

// Texto "inicio-apresentacao" em Textos do site, no EmDash
const { lang } = Astro.props;
const texto = await buscarTexto("inicio-apresentacao", lang);
---

{texto && (
  <section class="py-12">
    <div class="flex flex-col md:flex-row gap-6 items-center max-w-7xl mx-auto px-4">
      <div class="md:w-1/2 w-full text-center">
        {texto.imagem && (
          <Image
            image={texto.imagem}
            alt={texto.imagem.alt || "Imagem introdutória"}
            class="rounded w-full h-auto max-w-md mx-auto"
          />
        )}
      </div>
      <div class="md:w-1/2 w-full text-start">
        <div class="paragrafos_institucionais texto-cms">
          <PortableText value={texto.texto ?? []} />
        </div>
      </div>
    </div>
  </section>
)}
