---
import { Image, PortableText } from "emdash/ui";
import { useTranslations } from "../i18n/translations";
import { buscarTexto } from "../lib/conteudo";

// Texto "inicio-sobre" em Textos do site, no EmDash
const { lang } = Astro.props;
const t = useTranslations(lang);
const texto = await buscarTexto("inicio-sobre", lang);
const link = `/${lang}/sobre`;
---

{texto && (
  <section class="py-12 bg-[#F1E6E6]">
    <div class="flex flex-col md:flex-row gap-8 items-center max-w-7xl mx-auto px-4">
      <div class="md:w-1/2 w-full">
        <h2 class="text-2xl font-bold text-primary mb-4">{texto.titulo}</h2>
        <div class="paragrafos_institucionais texto-cms">
          <PortableText value={texto.texto ?? []} />
        </div>
        <div class="text-right">
          <a href={link} class="inline-block bg-primary text-white px-5 py-2 rounded hover:bg-[#90070b] font-semibold text-sm transition">
            {t("home.sobre.btn")}
          </a>
        </div>
      </div>
      <div class="md:w-1/2 w-full text-center">
        {texto.imagem && (
          <a href={link}>
            <Image image={texto.imagem} alt={texto.imagem.alt || "Imagem sobre"} class="w-full max-w-md rounded mx-auto" />
          </a>
        )}
      </div>
    </div>
  </section>
)}
