---
import { Image } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/translations";
import { idiomaValido, listarMembros } from "../../lib/conteudo";

const { lang } = Astro.params;
if (!idiomaValido(lang)) return Astro.rewrite("/404");
const t = useTranslations(lang);

// Membros cadastrados em Equipe, no EmDash
const membros = await listarMembros(lang);
---

<Layout lang={lang} t={t}>
  <main class="max-w-6xl mx-auto px-4 py-8 text-[#656565] font-light">
    <h1 class="text-[2rem] font-bold text-[#ab090e] mb-6">{t("equipe.titulo")}</h1>

    <div class="flex flex-wrap justify-center gap-6">
      {membros.map(({ data: membro }) => (
        <div class="w-full sm:w-[45%] lg:w-[30%] bg-[#f1f1f1] p-4 rounded-lg shadow-md">
          <div class="w-full h-64 overflow-hidden rounded-md mb-4">
            {membro.foto ? (
              <Image
                image={membro.foto}
                alt={`Foto de ${membro.nome}`}
                class="object-cover object-center w-full h-full min-h-full rounded-md bg-gray-200"
              />
            ) : (
              <img
                src="/images/equipe/00-person.svg"
                alt={`Foto de ${membro.nome}`}
                class="object-cover object-center w-full h-full min-h-full rounded-md bg-gray-200"
                loading="lazy"
              />
            )}
          </div>

          <div class="flex gap-3 justify-center items-center mb-3">
            {membro.lattes && (
              <a href={membro.lattes} target="_blank" rel="noopener noreferrer">
                <img src="/images/logos/lattes_icon.svg" alt="Currículo Lattes" class="w-12 h-12" />
              </a>
            )}
            {membro.instagram && (
              <a href={membro.instagram} target="_blank" rel="noopener noreferrer">
                <img src="/images/logos/instagram_icon_cinza.svg" alt="Instagram" class="w-8 h-8" />
              </a>
            )}
          </div>

          <h2 class="text-[#ab090e] text-lg font-bold mb-1">{membro.nome}</h2>
          <p class="text-sm font-semibold mb-2">{membro.cargo}</p>
          <p class="text-[1.05rem] mb-3 leading-relaxed text-justify hyphens-auto">{membro.sobre}</p>
        </div>
      ))}
    </div>
  </main>
</Layout>
