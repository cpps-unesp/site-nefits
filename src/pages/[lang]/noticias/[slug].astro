---
import { decodeSlug, getEmDashEntry, getTranslations } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Layout from "../../../layouts/Layout.astro";
import { useTranslations } from "../../../i18n/translations";
import { idiomaValido } from "../../../lib/noticias";

const { lang } = Astro.params;
const slug = decodeSlug(Astro.params.slug);
if (!idiomaValido(lang) || !slug) return Astro.rewrite("/404");
const t = useTranslations(lang);

// Sem tradução publicada no idioma pedido, o EmDash devolve a versão em
// português (fallbackLocale = "pt").
const { entry: noticia, error, fallbackLocale } = await getEmDashEntry("noticias", slug, {
  locale: lang,
});
if (error) {
  console.error("Erro ao carregar notícia:", error);
  return new Response("Não foi possível carregar a notícia.", { status: 500 });
}
if (!noticia) return Astro.rewrite("/404");

const outroLang = lang === "pt" ? "en" : "pt";
const { translations } = await getTranslations("noticias", noticia.data.id);
const noticiaOutroIdioma = translations.find(
  (traducao) =>
    traducao.locale === outroLang && traducao.status === "published" && traducao.slug
);
---

<Layout lang={lang} t={t}>

  <main class="max-w-5xl mx-auto p-8">
    <div class="mb-12" lang={fallbackLocale ?? lang}>
      {fallbackLocale && (
        <p class="text-center text-sm text-neutral mb-6" lang={lang}>
          {t("noticias.noticiaIndisponivelNesseIdioma")}
        </p>
      )}

      <h1 class="text-[2rem] font-bold text-primary text-center mb-6">
        {noticia.data.title}
      </h1>

      {noticia.data.imagem && (
        <Image
          image={noticia.data.imagem}
          alt={noticia.data.title}
          class="mx-auto mb-8 rounded-lg shadow-md max-h-[400px] w-auto object-contain"
          placeholder={false}
          priority
        />
      )}

      <article class="prose prose-neutral prose-lg max-w-4xl mx-auto">
        <PortableText value={noticia.data.conteudo ?? []} />
      </article>
    </div>






    {noticiaOutroIdioma && (
      <div class="text-center mt-8">
        <a
          href={`/${outroLang}/noticias/${noticiaOutroIdioma.slug}`}
          class="inline-block px-6 py-3 bg-gray-200 hover:bg-gray-300 text-[#656565] rounded font-bold text-sm"
        >
          {outroLang === "pt" ? "Ver em Português" : "View in English"}
        </a>
      </div>
    )}

    <div class="text-center mt-12">
      <a href={`/${lang}/noticias`} class="inline-block px-6 py-3 bg-[#ab090e] hover:bg-[#90070b] text-white rounded font-bold text-sm">
        {t("noticias.voltarParaNoticias")}
      </a>
    </div>
  </main>
</Layout>
