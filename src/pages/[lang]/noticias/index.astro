---
import Layout from "../../../layouts/Layout.astro";
import Noticias from "../../../components/Noticias.astro";
import NoticiasCards from "../../../components/NoticiasCards.astro";
import { useTranslations } from "../../../i18n/translations";
import { categoriasDa, idiomaValido, listarNoticias } from "../../../lib/noticias";

// Conteúdo vem do EmDash a cada requisição: o que for publicado no painel
// aparece aqui sem novo build.
const { lang } = Astro.params;
if (!idiomaValido(lang)) return Astro.rewrite("/404");
const t = useTranslations(lang);

const { entries: noticias, error } = await listarNoticias(lang);
if (error) {
  console.error("Erro ao carregar notícias:", error);
  return new Response("Não foi possível carregar as notícias.", { status: 500 });
}
---

<Layout lang={lang} t={t}>


  <main class="max-w-7xl mx-auto p-8">
    <Noticias />

    <div class="flex flex-wrap gap-8 justify-center">
      {
        noticias.map((item) => (
          <NoticiasCards
            imagem={item.data.imagem}
            titulo={item.data.title}
            texto={item.data.resumo}
            link={`/${lang}/noticias/${item.data.slug}`}
            tags={categoriasDa(item)}
            lang={lang}
          />
        ))
      }
    </div>
  </main>
</Layout>
