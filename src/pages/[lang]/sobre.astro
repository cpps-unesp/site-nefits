---
import { Image, PortableText } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/translations";
import { buscarTexto, idiomaValido } from "../../lib/conteudo";

const { lang } = Astro.params;
if (!idiomaValido(lang)) return Astro.rewrite("/404");
const t = useTranslations(lang);

// Textos "sobre-quem-somos" e "sobre-objetivos" em Textos do site, no EmDash
const [quemSomos, objetivos] = await Promise.all([
  buscarTexto("sobre-quem-somos", lang),
  buscarTexto("sobre-objetivos", lang),
]);
---

<Layout lang={lang} t={t}>
  <main class="max-w-6xl mx-auto px-4 py-8 text-[#656565] font-light">
    <!-- QUEM SOMOS -->
    {quemSomos && (
      <section class="md:flex md:items-center md:justify-between gap-8 mb-10">
        <div class="md:w-2/3">
          <h1 class="text-[2rem] font-bold text-[#ab090e] mb-4">
            {quemSomos.titulo}
          </h1>
          {quemSomos.imagem && (
            <div class="mb-4 text-center md:hidden">
              <Image image={quemSomos.imagem} alt={quemSomos.imagem.alt || "Equipe NéFiTs"} class="mx-auto w-[18rem]" />
            </div>
          )}
          <div class="text-[1.1rem] texto-cms">
            <PortableText value={quemSomos.texto ?? []} />
          </div>
        </div>
        {quemSomos.imagem && (
          <div class="hidden md:block md:w-1/3 text-center">
            <Image image={quemSomos.imagem} alt={quemSomos.imagem.alt || "Equipe NéFiTs"} class="mx-auto w-[18rem]" />
          </div>
        )}
      </section>
    )}

    <!-- OBJETIVOS -->
    {objetivos && (
      <section class="mb-10">
        <div class="max-w-6xl mx-auto px-4">
          <h2 class="text-[2rem] font-bold text-[#ab090e] mb-4">
            {objetivos.titulo}
          </h2>

          <!-- Imagem no topo no mobile -->
          {objetivos.imagem && (
            <div class="mb-4 text-center md:hidden">
              <Image image={objetivos.imagem} alt={objetivos.imagem.alt || "Objetivos"} class="mx-auto w-[18rem]" />
            </div>
          )}

          <!-- Texto com imagem flutuante no desktop -->
          <div class="relative">
            {objetivos.imagem && (
              <Image
                image={objetivos.imagem}
                alt={objetivos.imagem.alt || "Objetivos"}
                class="hidden md:block md:float-left md:mr-6 md:mb-4 md:w-[22rem] object-contain"
              />
            )}
            <div class="text-[1.1rem] texto-cms">
              <PortableText value={objetivos.texto ?? []} />
            </div>
          </div>

          <div class="clear-both"></div>
        </div>
      </section>
    )}
  </main>
</Layout>
