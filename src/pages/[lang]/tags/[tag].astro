---
import { getTerm } from "emdash";
import slugify from "slugify";
import Layout from "../../../layouts/Layout.astro";
import NoticiasCards from "../../../components/NoticiasCards.astro";

import { useTranslations } from "../../../i18n/translations";
import { categoriasDa, idiomaValido, listarNoticias } from "../../../lib/conteudo";

function decodificar(valor = "") {
  try {
    return decodeURIComponent(valor);
  } catch {
    return valor;
  }
}

const { lang } = Astro.params;
const tag = decodificar(Astro.params.tag);
if (!idiomaValido(lang) || !tag) return Astro.rewrite("/404");
const t = useTranslations(lang);

const categoria = await getTerm("tag", tag, { locale: lang });
if (!categoria) {
  // Links antigos usavam o nome da categoria (ex.: /pt/tags/Evento)
  const slug = slugify(tag, { lower: true, strict: true });
  if (slug !== tag && (await getTerm("tag", slug, { locale: lang }))) {
    return Astro.redirect(`/${lang}/tags/${slug}`, 301);
  }
}

const { entries: noticias, error } = categoria
  ? await listarNoticias(lang, categoria.slug)
  : { entries: [], error: undefined };
if (error) {
  console.error("Erro ao carregar notícias:", error);
  return new Response("Não foi possível carregar as notícias.", { status: 500 });
}
---

<Layout lang={lang} t={t}>
    <main class="max-w-7xl mx-auto px-4 py-8">
      <h1 class="text-2xl font-bold mb-6 text-center">
        {t("noticias.tags_titulo")} {categoria?.label ?? tag}
      </h1>

      <div class="flex flex-wrap gap-8 justify-center">
        {noticias.length > 0 ? (
          noticias.map((item) => (
            <NoticiasCards
              imagem={item.data.imagem}
              titulo={item.data.title}
              texto={item.data.resumo}
              link={`/${lang}/noticias/${item.data.slug}`}
              tags={categoriasDa(item)}
              lang={lang}
            />
          ))
        ) : (
          <p class="text-center text-gray-600">
            {t("noticias.sem_resultado") || "Nenhuma notícia encontrada com essa tag."}
          </p>
        )}
      </div>
    </main>
  </Layout>
