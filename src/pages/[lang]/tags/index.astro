---
import { getTaxonomyTerms } from "emdash";
import Layout from "../../../layouts/Layout.astro";

import { useTranslations } from "../../../i18n/translations";
import { idiomaValido } from "../../../lib/noticias";

const { lang } = Astro.params;
if (!idiomaValido(lang)) return Astro.rewrite("/404");
const t = useTranslations(lang);

// Categorias cadastradas no EmDash que têm ao menos uma notícia publicada
const categorias = (await getTaxonomyTerms("tag", { locale: lang }))
  .filter((categoria) => (categoria.count ?? 0) > 0)
  .sort((a, b) => a.label.localeCompare(b.label, lang));
---

<Layout lang={lang} t={t}>
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-center mb-8">
      {t("noticias.todas_tags")}
    </h1>

    {categorias.length > 0 ? (
      <ul class="flex flex-wrap gap-4 justify-center">
        {categorias.map((categoria) => (
          <li>
            <a
              href={`/${lang}/tags/${categoria.slug}`}
              class="bg-[#ab090e]/10 text-[#ab090e] px-3 py-1 rounded text-sm hover:underline"
            >
              {categoria.label}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center text-gray-600">
        {t("noticias.sem_tags")}

      </p>
    )}
  </main>
</Layout>
